# Copy to nomo.yaml and run: nomo-cli pipeline --config nomo.yaml --out release.tar.gz
model: attitude_policy
hardware: akd1500
mode: low_power_neuromorphic

# Optional versioned enterprise contract. It merges profile.config into this file
# and records the validated profile/fingerprint in the release manifest.
# enterprise_profile: ./nomo/enterprise/examples/hard_realtime_robotics.yaml

budgets:
  accuracy_drop_max: 4.0
  energy_j: 0.001

search:
  population: 32
  rounds: 12
  seed: 7
  asf_weights: [2.0, 1.0, 1.0]

# Optional .npz/.npy/.json file with 100-500 input tensors.
# calibration: ./calibration.npz

export:
  archive: tar.gz
  formats: [enterprise, design, pdf, pytorch, nir, c11]
